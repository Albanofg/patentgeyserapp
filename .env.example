# PatentGeyser credits purchase — Easy Pay Direct (NMI gateway).
# Security key (server-side, charges cards). Sensitive — store as encrypted secret.
EPD_SECURITY_KEY=
# Collect.js tokenization key (browser-side, tokenizes card details only).
EPD_PUBLIC_KEY=

# Private discount codes for the /purchase page (see client/src/pages/purchase.tsx).
# A comma-separated list of CODE:PERCENT pairs — the single source of truth for
# coupons. Multiple codes can be active at once, each with its own percent (1-99).
# Add/rotate/remove codes by editing this one var. Example:
#   PURCHASE_COUPON_CODES=LAUNCH25:25,AIA50:50
PURCHASE_COUPON_CODES=

# Admin access — comma-separated list of emails granted admin in the app.
# Required (server refuses to boot if unset). Rotate by editing this env var only.
ADMIN_EMAILS=
