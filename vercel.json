{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "regions": ["cle1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "server/modules/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
